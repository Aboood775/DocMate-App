<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected slot: navy border, light blue fill -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/docmate_blue_light" />
            <stroke
                android:width="1.5dp"
                android:color="@color/docmate_navy" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Disabled slot: already booked, greyed out -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/slot_disabled_bg" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Normal slot -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_primary" />
            <stroke
                android:width="1dp"
                android:color="@color/card_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
