<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="profile"
            type="com.example.docmate.domain.model.UserProfile" />
        <variable
            name="viewModel"
            type="com.example.docmate.presentation.main.profile.ProfileViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- Header Options -->
                <ImageView
                    android:id="@+id/ivMore"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_more_horiz"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_primary" />

                <!-- Profile Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_profile_header"
                    android:padding="24dp"
                    app:layout_constraintTop_toBottomOf="@id/ivMore">

                    <TextView
                        android:id="@+id/tvAvatarInitials"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:gravity="center"
                        android:text="@{profile.initials()}"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="SM" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="@{profile.fullName}"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvAvatarInitials"
                        app:layout_constraintTop_toTopOf="@id/tvAvatarInitials"
                        tools:text="Sarah Mitchell" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@{profile.email}"
                        android:textColor="#B0C4DE"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvName"
                        app:layout_constraintTop_toBottomOf="@id/tvName"
                        tools:text="sarah@email.com" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@{profile.location}"
                        android:textColor="#B0C4DE"
                        android:textSize="14sp"
                        android:visibility="@{profile.location != null &amp;&amp; !profile.location.isEmpty() &amp;&amp; !profile.location.equals(`Not specified`) ? android.view.View.VISIBLE : android.view.View.GONE}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvName"
                        app:layout_constraintTop_toBottomOf="@id/tvEmail"
                        tools:text="Cairo, Egypt" />

                    <TextView
                        android:id="@+id/tvBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_premium_badge"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="4dp"
                        android:text="Premium member"
                        android:textColor="@color/docmate_navy"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="@{profile.premium ? android.view.View.VISIBLE : android.view.View.GONE}"
                        app:layout_constraintStart_toStartOf="@id/tvName"
                        app:layout_constraintTop_toBottomOf="@id/tvLocation" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ACCOUNT Section -->
                <TextView
                    android:id="@+id/tvAccountHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="ACCOUNT"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardProfile" />

                <LinearLayout
                    android:id="@+id/llAccountMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/tvAccountHeader">

                    <!-- Personal Info -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnPersonalInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="12dp">

                        <View
                            android:id="@+id/bgIcon1"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_profile_icon_personal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_profile"
                            app:layout_constraintBottom_toBottomOf="@id/bgIcon1"
                            app:layout_constraintEnd_toEndOf="@id/bgIcon1"
                            app:layout_constraintStart_toStartOf="@id/bgIcon1"
                            app:layout_constraintTop_toTopOf="@id/bgIcon1"
                            app:tint="@color/profile_icon_personal" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Personal info"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/ivChevron1"
                            app:layout_constraintStart_toEndOf="@id/bgIcon1"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivChevron1"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/text_hint" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- My Appointments -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnAppointments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="12dp">

                        <View
                            android:id="@+id/bgIcon2"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_profile_icon_appointments"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_calendar"
                            app:layout_constraintBottom_toBottomOf="@id/bgIcon2"
                            app:layout_constraintEnd_toEndOf="@id/bgIcon2"
                            app:layout_constraintStart_toStartOf="@id/bgIcon2"
                            app:layout_constraintTop_toTopOf="@id/bgIcon2"
                            app:tint="@color/profile_icon_appointments" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="My appointments"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/ivChevron2"
                            app:layout_constraintStart_toEndOf="@id/bgIcon2"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivChevron2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/text_hint" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Payment Methods -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnPaymentMethods"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="12dp">

                        <View
                            android:id="@+id/bgIcon3"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_profile_icon_payment"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_cash"
                            app:layout_constraintBottom_toBottomOf="@id/bgIcon3"
                            app:layout_constraintEnd_toEndOf="@id/bgIcon3"
                            app:layout_constraintStart_toStartOf="@id/bgIcon3"
                            app:layout_constraintTop_toTopOf="@id/bgIcon3"
                            app:tint="@color/profile_icon_payment" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/payment_methods"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/ivChevron3"
                            app:layout_constraintStart_toEndOf="@id/bgIcon3"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivChevron3"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/text_hint" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

                <!-- SUPPORT Section -->
                <TextView
                    android:id="@+id/tvSupportHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="SUPPORT"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/llAccountMenu" />

                <LinearLayout
                    android:id="@+id/llSupportMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/tvSupportHeader">

                    <!-- Help & Support -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnSupport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="12dp">

                        <View
                            android:id="@+id/bgIcon4"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_profile_icon_support"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_bell"
                            app:layout_constraintBottom_toBottomOf="@id/bgIcon4"
                            app:layout_constraintEnd_toEndOf="@id/bgIcon4"
                            app:layout_constraintStart_toStartOf="@id/bgIcon4"
                            app:layout_constraintTop_toTopOf="@id/bgIcon4"
                            app:tint="@color/profile_icon_support" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Help &amp; support"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/ivChevron4"
                            app:layout_constraintStart_toEndOf="@id/bgIcon4"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivChevron4"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/text_hint" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Dark Mode -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnDarkMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="12dp">

                        <View
                            android:id="@+id/bgIcon5"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_profile_icon_support"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eye_24"
                            app:layout_constraintBottom_toBottomOf="@id/bgIcon5"
                            app:layout_constraintEnd_toEndOf="@id/bgIcon5"
                            app:layout_constraintStart_toStartOf="@id/bgIcon5"
                            app:layout_constraintTop_toTopOf="@id/bgIcon5"
                            app:tint="@color/profile_icon_support" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Dark Mode"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/switchDarkMode"
                            app:layout_constraintStart_toEndOf="@id/bgIcon5"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDarkMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

                <!-- Logout -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="@{() -> viewModel.logout()}"
                    android:paddingVertical="12dp"
                    app:layout_constraintTop_toBottomOf="@id/llSupportMenu">

                    <ImageView
                        android:id="@+id/ivIconLogout"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:rotation="180"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/colorError" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Logout"
                        android:textColor="@color/colorError"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivIconLogout"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>