<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:textDirection="ltr"
    android:background="@drawable/bg_auth_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layoutDirection="ltr"
        android:textDirection="ltr"
        android:paddingStart="32dp"
        android:paddingTop="42dp"
        android:paddingEnd="32dp"
        android:paddingBottom="80dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <ImageView
            android:layout_width="180dp"
            android:layout_height="160dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="centerInside"
            android:src="@drawable/docmate_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textAlignment="center"
            android:textDirection="ltr"
            android:text="@string/app_name"
            android:textColor="@color/docmate_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textAlignment="center"
            android:textDirection="ltr"
            android:text="@string/splash_subtitle"
            android:textColor="@color/docmate_accent"
            android:textSize="18sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="64dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/getStartedButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:fontFamily="serif"
            android:text="@string/sign_up"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/docmate_primary"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alreadyHaveAccountButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:text="@string/sign_in"
            android:textAllCaps="false"
            android:textColor="@color/docmate_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/white"
            app:cornerRadius="18dp"
            app:strokeColor="@color/docmate_input_border"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
