<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Primary full-width button (navy background, white text) -->
    <style name="Widget.DocMate.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/btn_primary_background</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small primary button, used inside doctor cards ("Book") -->
    <style name="Widget.DocMate.Button.Primary.Small" parent="Widget.DocMate.Button.Primary">
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Secondary outlined button (e.g. "Reschedule", "Add to calendar") -->
    <style name="Widget.DocMate.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/docmate_navy</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/docmate_navy</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Specialty filter chip -->
    <style name="Widget.DocMate.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/background_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

</resources>
